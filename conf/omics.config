params {
    ecr_registry = ''
    outdir = '/mnt/workflow/pubdir'
}
manifest {
    nextflowVersion = '!>=23.10'
}
conda {
    enabled = false
}
process {
    withName: '.*' { conda = null }
    withName: '(.+:)?SEQKIT_REPLACE'                    { container = 'biocontainers/seqkit:2.1.0--h9ee0642_0'}
    withName: '(.+:)?GATK4_SELECTVARIANTS'              { container = 'biocontainers/gatk4:4.2.5.0--hdfd78af_0'}
    withName: '(.+:)?SNPEFF_BUILD'                      { container = 'biocontainers/snpeff:5.0--hdfd78af_1'}
    withName: '(.+:)?RAXMLNG'                           { container = 'biocontainers/raxml-ng:1.0.3--h32fcf60_0'}
    withName: '(.+:)?TABIX_BGZIPTABIX'                  { container = 'biocontainers/tabix:1.11--hdfd78af_0'}
    withName: '(.+:)?FASTTREE'                          { container = 'biocontainers/fasttree:2.1.10--h516909a_4'}
    withName: '(.+:)?QUALIMAP_BAMQC'                    { container = 'biocontainers/qualimap:2.2.2d--1'}
    withName: '(.+:)?BWA_MEM'                           { container = 'biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:c56a3aabc8d64e52d5b9da1e8ecec2031668596d-0'}
    withName: '(.+:)?PICARD_MARKDUPLICATES'             { container = 'biocontainers/picard:2.26.10--hdfd78af_0'}
    withName: '(.+:)?INPUT_PROC'                        { container = 'biocontainers/python:3.8.3'}
    withName: '(.+:)?PICARD_ADDORREPLACEREADGROUPS'     { container = 'biocontainers/picard:2.26.10--hdfd78af_0'}
    withName: '(.+:)?GATK4_COMBINEGVCFS'                { container = 'biocontainers/gatk4:4.2.5.0--hdfd78af_0'}
    withName: '(.+:)?SAMTOOLS_STATS'                    { container = 'biocontainers/samtools:1.15--h1170115_1'}
    withName: '(.+:)?FAQCS'                             { container = 'biocontainers/faqcs:2.10--r41h9a82719_2'}
    withName: '(.+:)?SEQTK_SAMPLE'                      { container = 'biocontainers/seqtk:1.3--h5bf99c6_3'}
    withName: '(.+:)?RAPIDNJ'                           { container = 'biocontainers/mulled-v2-805c6e0f138f952f9c61cdd57c632a1a263ea990:3c52e4c8da6b3e4d69b9ca83fa4d366168898179-0'}
    withName: '(.+:)?GATK4_HAPLOTYPECALLER'             { container = 'biocontainers/gatk4:4.2.5.0--hdfd78af_0'}
    withName: '(.+:)?SPLIT_VCF'                         { container = 'biocontainers/bcftools:1.14--h88f3f91_0'}
    withName: '(.+:)?GATK4_VARIANTFILTRATION'           { container = 'biocontainers/gatk4:4.2.5.0--hdfd78af_0'}
    withName: '(.+:)?SNPDISTS'                          { container = 'biocontainers/snp-dists:0.8.2--h5bf99c6_0'}
    withName: '(.+:)?NUCMER'                            { container = 'biocontainers/mummer:3.23--pl5262h1b792b2_12'}
    withName: '(.+:)?VCF_CONSENSUS'                     { container = 'biocontainers/bcftools:1.14--h88f3f91_0'}
    withName: '(.+:)?SAMTOOLS_INDEX'                    { container = 'biocontainers/samtools:1.15--h1170115_1'}
    withName: '(.+:)?GATK4_GENOTYPEGVCFS'               { container = 'biocontainers/gatk4:4.2.5.0--hdfd78af_0'}
    withName: '(.+:)?FASTQC'                            { container = 'biocontainers/fastqc:0.11.9--0'}
    withName: '(.+:)?SNPEFF'                            { container = 'biocontainers/snpeff:4.3.1t--hdfd78af_5'}
    withName: '(.+:)?SRATOOLS_PREFETCH'                 { container = 'biocontainers/sra-tools:2.11.0--pl5262h314213e_0'}
    withName: '(.+:)?SNPEFFR'                           { container = 'ghcr.io/cdcgov/snpeffr:master'}
    withName: '(.+:)?QC_REPORTSHEET'                    { container = 'biocontainers/python:3.8.3'}
    withName: '(.+:)?PICARD_FIXMATEINFORMATION'         { container = 'biocontainers/picard:2.26.10--hdfd78af_0'}
    withName: '(.+:)?BCFTOOLS_QUERY'                    { container = 'biocontainers/bcftools:1.14--h88f3f91_0'}
    withName: '(.+:)?MULTIQC'                           { container = 'biocontainers/multiqc:1.11--pyhdfd78af_0'}
    withName: '(.+:)?VCF_QC'                            { container = 'biocontainers/python:3.8.3'}
    withName: '(.+:)?GATK4_LOCALCOMBINEGVCFS'           { container = 'biocontainers/gatk4:4.2.5.0--hdfd78af_0'}
    withName: '(.+:)?FILTER_GATK_GENOTYPES'             { container = 'biocontainers/scipy:1.1.0'}
    withName: '(.+:)?SRATOOLS_FASTERQDUMP'              { container = 'biocontainers/mulled-v2-5f89fe0cd045cb1d615630b9261a1d17943a9b6a:6a9ff0e76ec016c3d0d27e0c0d362339f2d787e6-0'}
    withName: '(.+:)?BCFTOOLS_INDEX'                    { container = 'biocontainers/bcftools:1.14--h88f3f91_0'}
    withName: '(.+:)?PICARD_CREATESEQUENCEDICTIONARY'   { container = 'biocontainers/picard:2.26.10--hdfd78af_0'}
    withName: '(.+:)?SAMTOOLS_SORT'                     { container = 'biocontainers/samtools:1.15--h1170115_1'}
    withName: '(.+:)?LANE_MERGE'                        { container = 'biocontainers/python:3.8.3'}
    withName: '(.+:)?BWA_INDEX'                         { container = 'biocontainers/bwa:0.7.17--hed695b0_7'}
    withName: '(.+:)?SAMTOOLS_VIEW'                     { container = 'biocontainers/samtools:1.15--h1170115_1'}
    withName: '(.+:)?SAMTOOLS_FAIDX'                    { container = 'biocontainers/samtools:1.15--h1170115_1'}
    withName: '(.+:)?VCF_TO_FASTA'                      { container = 'biocontainers/scipy:1.1.0'}
    withName: '(.+:)?SAMTOOLS_FLAGSTAT'                 { container = 'biocontainers/samtools:1.15--h1170115_1'}
    withName: '(.+:)?SAMPLESHEET_CHECK'                 { container = 'biocontainers/python:3.8.3'}
    withName: '(.+:)?QC_REPORT'                         { container = 'biocontainers/pandas:1.5.2'}
    withName: '(.+:)?IQTREE'                            { container = 'biocontainers/iqtree:2.1.4_beta--hdcc8f71_0'}
    withName: '(.+:)?DOWNSAMPLE_RATE'                   { container = 'biocontainers/python:3.8.3'}
    withName: '(.+:)?SEQKIT_PAIR'                       { container = 'biocontainers/seqkit:2.1.0--h9ee0642_0'}
    withName: '(.+:)?BCFTOOLS_VIEW'                     { container = 'biocontainers/bcftools:1.14--h88f3f91_0'}
    withName: '(.+:)?PICARD_CLEANSAM'                   { container = 'biocontainers/picard:2.26.10--hdfd78af_0'}
    withName: '(.+:)?BEDTOOLS_MASKFASTA'                { container = 'biocontainers/bedtools:2.30.0--hc088bd4_0'}
    withName: '(.+:)?SAMTOOLS_IDXSTATS'                 { container = 'biocontainers/samtools:1.15--h1170115_1'}
    withName: '(.+:)?COORDSTOBED'                       { container = 'biocontainers/mummer:3.23--pl5262h1b792b2_12'}
    withName: '(.+:)?CUSTOM_DUMPSOFTWAREVERSIONS'       { container = 'biocontainers/multiqc:1.11--pyhdfd78af_0'}
    withName: '(.+:)?QUICKSNP'                          { container = 'staphb/quicksnp:1.0.1'}

}
docker {
    enabled = true
    registry = '<ACCT_NUMBER>.dkr.ecr.us-east-1.amazonaws.com'
}
